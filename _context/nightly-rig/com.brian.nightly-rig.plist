<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brian.nightly-rig</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/b/Desktop/PhoneThatCares/_context/nightly-rig/run.sh</string>
    </array>

    <!-- Fire daily at 3:30am local time (lowest token-interruption window) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Don't pile up missed runs if the Mac was asleep at 3:30 -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/b/Desktop/PhoneThatCares/_context/nightly-rig/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/b/Desktop/PhoneThatCares/_context/nightly-rig/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/b/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
